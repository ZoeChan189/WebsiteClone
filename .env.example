NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Generate independent random values with at least 32 characters.
SESSION_SECRET=replace-with-a-random-session-secret
DATA_ENCRYPTION_KEY=replace-with-an-independent-data-encryption-key
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_MAX_AGE_MS=86400000

# Keep the live database outside the Git checkout.
DATA_FILE=/var/lib/storetainguyen/db.json
MAX_BODY_BYTES=250000
ALLOW_REGISTRATION=false
TRUST_PROXY_HEADERS=true

TELEGRAM_BOT_URL=https://t.me/YourBot
BOT_WEBHOOK_SECRET=replace-with-a-random-bot-access-secret
BOT_WEBHOOK_SIGNING_SECRET=replace-with-a-different-signing-secret
BOT_REQUIRE_SIGNATURE=true
BOT_REQUIRE_PAYMENT_REF=true
BOT_WEBHOOK_MAX_SKEW_MS=300000

CANBOSO_API_BASE=https://canboso.com
CANBOSO_API_KEY=replace-with-a-new-rotated-api-key
CANBOSO_MARKUP_VND=10000
